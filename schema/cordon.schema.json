{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/wangyuchen5110/opencode-cordon/main/schema/cordon.schema.json",
  "title": "opencode-cordon policy",
  "description": "A declarative permission cordon for OpenCode 2.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "preset": {
      "enum": ["relaxed", "balanced", "strict"],
      "default": "balanced",
      "description": "Built-in rule set evaluated after user rules."
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "path": { "type": "string", "default": ".opencode/cordon/audit.jsonl" },
        "redact": { "type": "boolean", "default": true },
        "storeCommand": { "type": "boolean", "default": true },
        "commandHash": { "type": "boolean", "default": false }
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "effect", "match"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "effect": { "enum": ["allow", "deny", "ask"] },
          "reason": { "type": "string" },
          "match": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "action": { "$ref": "#/definitions/globOrGlobs" },
              "tool": { "$ref": "#/definitions/globOrGlobs" },
              "command": { "$ref": "#/definitions/globOrGlobs" },
              "path": { "$ref": "#/definitions/globOrGlobs" },
              "agent": { "$ref": "#/definitions/globOrGlobs" }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "globOrGlobs": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      ]
    }
  }
}
